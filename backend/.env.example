# ===== 应用 =====
APP_NAME=智能简历诊断与面试模拟平台
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
# 生产环境必须替换为随机值：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== PostgreSQL 17 =====
# 必须使用 PostgreSQL；应用账号不要使用超级管理员 postgres
# 应用使用 asyncpg，Alembic 自动转换为 psycopg 同步连接
DATABASE_URL=postgresql+asyncpg://resume_app:CHANGE_ME@127.0.0.1:5432/resume_platform
# 认证集成测试专用库；留空则自动跳过需要数据库的测试
TEST_DATABASE_URL=postgresql+asyncpg://resume_app:CHANGE_ME@127.0.0.1:5432/resume_platform_test
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ===== DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_OUTPUT_TOKENS=8192

# ===== 文件 =====
UPLOAD_DIR=var/uploads
MAX_UPLOAD_SIZE_MB=10

# ===== 日志 =====
LOG_LEVEL=INFO
