# 复制为 .env.docker 后填写；不要提交 .env.docker。
# 生成随机值：python -c "import secrets; print(secrets.token_hex(32))"

# ===== PostgreSQL =====
POSTGRES_DB=resume_platform
POSTGRES_USER=resume_app
# 建议只使用字母、数字和 - _，避免 URL 特殊字符
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ===== 应用 =====
# 至少 32 位随机字符串；生产环境缺失会拒绝启动
SECRET_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080

# ===== DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60

# ===== 文件与日志 =====
MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=INFO
